# CollabX configuration -- every value here is optional.
#
# With none of it set, CollabX runs its deterministic engine: no key, no
# network, no model. That is the default on purpose, so a fresh clone works
# immediately and CI stays hermetic.
#
# Copy to .env and edit only if you want a model.  cp .env.example .env

# ---------------------------------------------------------------------------
# Which engine writes the drafts
# ---------------------------------------------------------------------------
# deterministic  template engine, always works, no key            (default)
# ollama         local model, free, offline, no key
# gemini         Google free tier, needs GEMINI_API_KEY
#
# "auto" resolves to deterministic. It deliberately does NOT auto-detect a
# running Ollama server: two machines running the same command must produce
# the same output, and silent auto-detection breaks that.
COLLABX_PROVIDER=deterministic

# ---------------------------------------------------------------------------
# Ollama -- free, local, no account
# ---------------------------------------------------------------------------
#   1. install Ollama
#   2. ollama pull llama3.2
#   3. COLLABX_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Gemini -- free tier, needs a key
# ---------------------------------------------------------------------------
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key-here
#
# Defaults to the "lite" floating alias for two reasons: pinned model ids get
# retired (gemini-2.0-flash now 404s), and the full flash models spend thinking
# tokens out of the same output budget, which can return no visible text at all.
# GEMINI_MODEL=gemini-flash-lite-latest
